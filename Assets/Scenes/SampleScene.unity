  m_Script: {fileID: 11500000, guid: e61a67adbada5364c877d11a2776046e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CandlePuzzleManager
  candles: []
  correctOrder: 0100000002000000030000000400000005000000
  resetDelay: 0.6
  motherMessages:
  - "Con trai \xE0... Ng\xE0y con ch\xE0o \u0111\u1EDDi, m\u1EB9 \u0111\xE3 h\u1EE9a
    s\u1EBD lu\xF4n b\u1EA3o v\u1EC7 con. M\u1EB9 v\u1EABn nh\u1EDB n\u1EE5 c\u01B0\u1EDDi
    c\u1EE7a con \u2014 nh\u01B0 m\u1ED9t ng\u1ECDn \u0111\xE8n nh\u1ECF soi s\xE1ng
    cu\u1ED9c \u0111\u1EDDi c\u1EE7a m\u1EB9 v\u1EADy. Con c\xF3 bi\u1EBFt kh\xF4ng,
    con ch\xEDnh l\xE0 m\xF3n qu\xE0 tuy\u1EC7t v\u1EDDi nh\u1EA5t c\u1EE7a m\u1EB9
    \u0111\xF3 "
  - "Con c\xF2n nh\u1EDB kh\xF4ng, khi nh\u1EEFng l\u1EA7n m\u1EB9 t\u1EAFm cho con?
    Ch\xFAng ta \u0111\xE3 c\xF9ng n\xF4 \u0111\xF9a, t\u1EA1o h\xECnh ki\u1EC3u
    t\xF3c, c\u0169ng nh\u01B0 gi\u1ECDc n\u01B0\u1EDBc. L\xFAc \u1EA5y ti\u1EBFng
    c\u01B0\u1EDDi c\u1EE7a con khi\u1EBFn tim m\u1EB9 \u1EA5m \xE1p nh\u01B0 gi\xF3
    m\xF9a xu\xE2n v\u1EADy. Nh\u1EEFng kho\u1EA3nh kh\u1EAFc \u1EA5y m\u1EB9 mang
    theo su\u1ED1t \u0111\u1EDDi. "
  - " C\xF3 nh\u1EEFng ng\xE0y... m\u1EB9 th\u1EA5y qu\xE1 m\u1EC7t m\u1ECFi. M\u1EB9
    lo r\u1EB1ng m\xECnh kh\xF4ng c\xF2n \u0111\u1EE7 s\u1EE9c \u0111\u1EC3 che ch\u1EDF
    con nh\u01B0 tr\u01B0\u1EDBc. Nh\u01B0ng m\u1EB9 v\u1EABn c\u1ED1, v\xEC con. "
  - "M\u1EB9... xin l\u1ED7i con. M\u1EB9 \u01B0\u1EDBc m\u1EB9 c\xF3 th\u1EC3 \u1EDF
    b\xEAn con l\xE2u h\u01A1n, nh\u01B0ng m\u1EB9... v\xEC s\u1EE9c kh\u1ECFe c\u1EE7a
    m\u1EB9 \u0111ang d\u1EA7n m\u1ED9t y\u1EBFu \u0111i. Mong con \u0111\u1EEBng
    o\xE1n gi\u1EADn m\u1EB9... "
  - "D\xF9 m\u1EB9 kh\xF4ng c\xF2n b\xEAn con... M\u1EB9 v\u1EABn \u1EDF \u0111\xE2y,
    trong \xE1nh s\xE1ng v\xE0 k\xFD \u1EE9c con mang theo. H\xE3y s\u1ED1ng m\u1EA1nh
    m\u1EBD nh\xE9, con trai c\u1EE7a m\u1EB9. M\u1EB9 lu\xF4n y\xEAu con. "
  motherVoiceClips:
  - {fileID: 8300000, guid: 0b664d0cb483b1d478ff2bc4fd4b0ed0, type: 3}
  - {fileID: 8300000, guid: 7ff82500c21d12b4092999f3580f7279, type: 3}
