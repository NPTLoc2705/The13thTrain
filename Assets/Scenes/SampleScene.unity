      m_Calls: []
  m_text: "My dear son,\nIf you\u2019re reading this, it means I couldn\u2019t tell
    you myself. I\u2019m sorry for leaving you alone so soon. Inside the safe lies
    something meant to remind you that love never fades \u2014 not even when I\u2019m
    gone.\nThe code is 18082\u2026 use it wisely, and remember, I\u2019m always with
    you."
  m_isRightToLeft: 0
