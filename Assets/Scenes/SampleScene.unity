  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e94411172268d6f4098d53cb2fda6e91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  noteText: "N\u0103m n\u01A1i m\u1EB9 t\u1EEBng \u1EDF, n\u0103m ng\u1ECDn l\u1EEDa
    \u1EA5m t\u1EEBng soi.\nN\u1EB1m \u0111\u1EA7u l\xE0 gi\u1EA5c ng\u1EE7 n\u01A1i
    con m\u01A1,\nTi\u1EBFp \u0111\u1EBFn n\u01A1i m\u1EB9 r\u1EEDa nh\u1EEFng n\u1ED7i
    bu\u1ED3n tr\xF4i,\nB\xE0n \u0103n n\u01A1i chi\u1EBFc gh\u1EBF tr\u1ED1ng v\u1EABn
    ch\u1EDD,\nN\u01A1i m\u1EB9 t\u1EEBng n\u1EB1m, ch\u1EE9a \xE2u lo,\nV\xE0 cu\u1ED1i
    c\xF9ng n\u01A1i c\u1EA3 nh\xE0 t\u1EE5 h\u1ECDp \u2014 \xE1nh s\xE1ng d\u1EABn
    l\u1ED1i.\nTh\u1EAFp theo d\xF2ng ch\u1EA3y k\xFD \u1EE9c, ng\u1ECDn n\u1EBFn
    s\u1EBD h\xE9 l\u1ED9."
  riddleUIPrefab: {fileID: 412986348410815929}
  openOnce: 1
  interactPrompt: "[E] \u0110\u1ECDc m\u1EA3nh gi\u1EA5y"
  playMonologueAfterClose: 1
  afterCloseMonologue: "L\u1EA7n \u0111\u1EA7u?, c\u0103n ph\xF2ng? m\u1EB9 \u0111ang
    mu\u1ED1n \xE1m ch\u1EC9 \u0111i\u1EC1u g\xEC cho m\xECnh sao"
  addToJournalOnRead: 0
  journalEntryID: note_riddle_01
  journalTitle: A Torn Note
