--- !u!114 &4012670486848977971
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2367376135056087852}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edb0be5c7f04da74b87baf350062f931, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteUI
  pages:
  - "Trang 1:\r\n\r\nB\u1EE9c v\u1EBD \u0111\u1EA7u ti\xEAn...  \r\nNg\u01B0\u1EDDi
    m\u1EB9 \xF4m \u0111\u1EE9a con trong v\xF2ng tay.  \r\nT\u1EF1a nh\u01B0 bu\u1ED5i
    s\u1EDBm y\xEAn b\xECnh, khi h\u01A1i th\u1EDF c\u1EE7a hai ng\u01B0\u1EDDi h\xF2a
    v\xE0o nhau,  \r\nkh\xF4ng c\xF3 g\xEC tr\xEAn \u0111\u1EDDi \u0111\xE1ng s\u1EE3
    h\u01A1n vi\u1EC7c r\u1EDDi xa b\xE0n tay \u1EA5y.\r\n\r\nH\xE3y gi\u1EEF l\u1EA5y
    s\u1EF1 t\u0129nh l\u1EB7ng ban \u0111\u1EA7u \u0111\xF3,  \r\n\u0111\u1EEBng
    xoay, \u0111\u1EEBng l\xE0m l\u1EC7ch, \u0111\u1EC3 k\xFD \u1EE9c \u1EA5y v\u1EABn
    c\xF2n nguy\xEAn v\u1EB9n.\r\n"
  - "Trang 2:\r\n\r\nNg\u01B0\u1EDDi cha c\xFAi xu\u1ED1ng, \u0111\u1EB7t b\xE0n
    tay l\xEAn vai c\u1EADu b\xE9.  \r\nChi\u1EBFc xe \u0111\u1EA1p kh\u1EADp khi\u1EC5ng
    tr\xEAn con \u0111\u01B0\u1EDDng \u0111\u1EA5t nh\u1ECF,  \r\nb\xE1nh xe l\u0103n
    nghi\xEAng \u2014 nh\u01B0 th\u1EBF gi\u1EDBi \u0111\u1EA3o l\u1ED9n,  \r\nnh\u01B0ng
    trong \xE1nh m\u1EAFt cha, c\xF3 ni\u1EC1m tin l\u1EB7ng l\u1EBD.\r\n\r\n\u0110\xF4i
    khi, ph\u1EA3i l\u1EADt ng\u01B0\u1EE3c n\u1ED7i s\u1EE3 \u0111\u1EC3 h\u1ECDc
    c\xE1ch \u0111\u1EE9ng v\u1EEFng.\r\n"
  - "Trang 3:\r\n\r\n\xC1nh \u0111\xE8n m\u1EDD, b\xE0n \u0103n ch\u1EADt h\u1EB9p, 
    \r\nm\xF9i canh c\xF2n v\u01B0\u01A1ng tr\xEAn \u0111\xF4i \u0111\u0169a.  \r\nC\u1EA3
    nh\xE0 c\u01B0\u1EDDi n\xF3i, ti\u1EBFng c\u01B0\u1EDDi vang nghi\xEAng trong
    c\u0103n b\u1EBFp c\u0169.  \r\nC\xF3 nh\u1EEFng kho\u1EA3nh kh\u1EAFc \u1EA5m
    \xE1p\u2026  \r\nnh\u01B0ng ch\u1EC9 c\xF2n vang v\u1ECDng, l\u1EC7ch \u0111i
    nh\u01B0 th\u1EDDi gian \u0111\xE3 nghi\xEAng sang chi\u1EC1u.\r\n\r\nGi\u1EEF
    l\u1EA5y k\xFD \u1EE9c \u1EA5y, d\xF9 ch\u1EB3ng th\u1EC3 ngay ng\u1EAFn nh\u01B0
    ban \u0111\u1EA7u.\r\n"
  - "Trang 4:\r\n\r\nTr\u01B0\u1EDBc hi\xEAn nh\xE0, ba ng\u01B0\u1EDDi \u0111\u1EE9ng
    c\u1EA1nh nhau.  \r\nM\xE1i ng\xF3i \u0111\u1ECF, khung c\u1EEDa s\u1ED5 m\u1EDF
    ra ph\xEDa b\xECnh minh.  \r\nKh\xF4ng c\xF2n n\u01B0\u1EDBc m\u1EAFt, ch\u1EC9
    c\xF2n gi\xF3 nh\u1EB9 l\u01B0\u1EDBt qua.\r\n\r\nCh\u1EC9 c\u1EA7n xoay v\u1EC1
    ph\xEDa \xE1nh s\xE1ng,  \r\ngia \u0111\xECnh \u1EA5y \u2014 d\u1EABu trong tranh
    \u2014 v\u1EABn \u0111ang m\u1EC9m c\u01B0\u1EDDi c\xF9ng nhau.\r\n"
  noteText: {fileID: 6960993279209098094}
  canvasGroup: {fileID: 2047970295227641119}
  audioSource: {fileID: 8875411727636607262}
  pageSound: {fileID: 8300000, guid: 358fe2d5fefaa5342ad08d8e3e1452d7, type: 3}
